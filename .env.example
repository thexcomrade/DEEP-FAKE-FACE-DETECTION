# Environment Configuration Example for Deepfake Face Detection
# Copy this file to .env and configure values for production deployment

# Application Secret Key (Required in production)
SECRET_KEY=your-secure-random-secret-key-change-me-in-production

# Environment Mode (production / development)
FLASK_ENV=development
FLASK_DEBUG=false

# Server Port
PORT=5000

# Optional Filesystem Overrides (Defaults to project structure)
# MODELS_DIR=backend/models
# UPLOAD_FOLDER=backend/static/uploads
